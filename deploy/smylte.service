# systemd unit for Smylte. Install to /etc/systemd/system/.
# Binds 127.0.0.1:8080 (see smylted/__main__.py); public exposure is via the
# cloudflared tunnel -> public Caddy site (see Caddyfile.snippet), never direct.
[Unit]
Description=Smylte — tasks and calendar web app (smylted)
After=network-online.target radicale.service
Wants=network-online.target

[Service]
Type=exec
User=nicholaskmitchell
Group=nicholaskmitchell
WorkingDirectory=/home/nicholaskmitchell/smylte/backend
EnvironmentFile=/etc/smylte/smylte.env
ExecStart=/home/nicholaskmitchell/smylte/backend/.venv/bin/python -m smylted
Restart=on-failure
RestartSec=3

# Hardening. The app parses attacker-influenced iCalendar/HTTP and is
# internet-reachable through the tunnel, so the sandbox is tight: no
# capabilities (it binds 127.0.0.1:8080, nothing privileged), no devices, no
# namespaces, loopback only.
#
# NOTHING UNDER /home IS WRITABLE, and that is the point of StateDirectory
# below. This used to read `ReadWritePaths=…/smylte/backend`, with a comment
# claiming it opened "the one path it needs (the SQLite cache)". It opened the
# whole tree: `.venv`, the interpreter ExecStart runs, and `smylted`, the source
# it imports. Every other line here exists to contain a compromise of this
# process, and all of them are moot against an attacker who can drop a one-line
# `.pth` into site-packages — the next restart executes it, as the same user,
# and the sandbox never notices, because the write went to a path the unit had
# deliberately opened.
#
# StateDirectory grants exactly /var/lib/smylte (creating it, owned by this
# user, mode 0700 under UMask below) and nothing else, so the venv and the
# source are read-only like the rest of /home. SMYLTE_DB in /etc/smylte/smylte.env
# points there. Moving an existing deployment: stop the unit, move smylte.db and
# its -wal/-shm sidecars into /var/lib/smylte, update SMYLTE_DB, start — see
# docs/DEPLOY.md, and note that setup.sh will not rewrite an env file that
# already exists.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=smylte
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
# Loopback only: Caddy in, Radicale out. If SMYLTE_ACCESS_REQUIRED is ever
# turned on, DELETE these two lines — the Cloudflare Access JWKS fetch needs
# outbound HTTPS.
#
# SIGNAL NOTIFICATIONS need no egress. They go to signal-bot on this machine
# (127.0.0.1:8801), which `IPAddressAllow=localhost` already allows. A token
# pasted in Settings is kept in the secret store, which under this unit needs
# the LoadCredential= line below.
#
# Do NOT simply delete the two lines to make room for anything else. This
# process parses attacker-influenced iCalendar and is internet-reachable
# through the tunnel; unrestricted egress turns a parser bug into an
# exfiltration channel. Widen it exactly as far as a feature needs, by ADDING
# allow lines above the deny. DNS also has to be reachable for any of them:
# systemd-resolved on 127.0.0.53 is already covered by `localhost`, but a
# deployment pointing /etc/resolv.conf at a LAN or public resolver must allow
# that address too, or names never resolve.
#
# EMAIL INGESTION needs api.anthropic.com, which Anthropic publishes as fixed
# ranges (docs.claude.com → API → IP addresses):
#
#   IPAddressAllow=160.79.104.0/23
#   IPAddressAllow=2607:6bc0::/48
#
# With a TypeSafe key set (Jev decides task-or-event and duplicates),
# api.typesafe.ai too. It sits on
# Cloudflare's shared anycast addresses (`getent hosts api.typesafe.ai`), so
# allowing it opens a slice of everything Cloudflare fronts — see DEPLOY.md
# before deciding that is worth it here. Without it Jev calls fail and the
# extraction model's choice stands.
#
# Bridge on this host, or tunnelled onto its loopback, is already covered by
# `localhost`. Its secrets key belongs here as a credential rather than under the
# read-only /home (see docs/DEPLOY.md):
#
#   LoadCredential=smylte-secrets-key:/etc/smylte/secrets.key
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
