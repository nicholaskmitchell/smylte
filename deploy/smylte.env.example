# Copy to /etc/smylte/smylte.env  (mode 0600, owned by the service user).
# NEVER commit the real file — it holds secrets.

# --- Radicale (production, over localhost; never exposed directly) ---
RADICALE_URL=http://127.0.0.1:5232
RADICALE_USER=nicholaskmitchell
RADICALE_PASSWORD=REPLACE_with_radicale_password

# --- where raw CalDAV is published for device clients ---
# Only used to answer RFC 6764 discovery: clients that cannot be given a path
# (Apple's takes a hostname and nothing else) probe /.well-known/caldav and the
# bare root, and get redirected here. Must match the Caddy /dav split. An
# absolute URL is fine if DAV moves to its own host, e.g. https://dav.example.com
SMYLTE_DAV_URL=/dav/

# --- storage / static ---
# Outside the source tree on purpose: the unit grants /var/lib/smylte through
# StateDirectory and nothing under /home, so the venv and the app's own code
# stay read-only to the process that parses untrusted iCalendar.
SMYLTE_DB=/var/lib/smylte/smylte.db
SMYLTE_STATIC=/home/nicholaskmitchell/smylte/frontend/dist
SMYLTE_SYNC_INTERVAL=30

# --- app auth (REQUIRED; the public gate) ---
SMYLTE_AUTH_ENABLED=true
SMYLTE_AUTH_USER=nick
# Generate: cd ~/smylte/backend && .venv/bin/python -m smylted hash-password
SMYLTE_AUTH_PASSWORD_HASH=REPLACE_scrypt_hash
# Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
SMYLTE_SESSION_SECRET=REPLACE_64_hex_chars
# Fallback only. Once the account picks a value under Settings -> Account
# ("Stay signed in"), that one wins on every login and editing this does
# nothing.
SMYLTE_SESSION_TTL=604800
SMYLTE_COOKIE_SECURE=true

# --- storage-hook shared secret (must match /etc/smylte/hook-secret) ---
SMYLTE_HOOK_SECRET=REPLACE_hook_secret

# --- Cloudflare Access (OPTIONAL second layer; leave off for simple user/pass) ---
SMYLTE_ACCESS_REQUIRED=false

# --- remote MCP connector (OPTIONAL; off unless enabled) ---
# Serves an OAuth-protected MCP endpoint at ${SMYLTE_PUBLIC_URL}/mcp so Claude —
# or any MCP client — can be connected to your tasks and calendar. Nothing is
# reachable until this is true, and the app refuses to start if it is true
# without a public URL, app auth, and a persistent session secret.
#
# Connecting still requires your app password at a consent screen, so knowing
# the URL is not enough. Manage or revoke connections in Settings > Connected apps.
SMYLTE_MCP_ENABLED=false
# This deployment's external origin. Required when the connector is on: the
# OAuth metadata must state absolute URLs, and the value a token is bound to has
# to match what the client was pointed at — so it is configured rather than read
# off the Host header, which the caller controls. No trailing slash.
SMYLTE_PUBLIC_URL=https://radicale.nicholaskmitchell.com

# --- Telegram notifications (OPTIONAL; off unless enabled) ---
# A daily digest, a nudge before a meeting starts, a note when someone books
# you, and a warning when sync has stopped working. What each rule is and when
# it fires is documented in backend/smylted/notify/rules.py; which of them are on
# is a per-account preference under Settings, not an env var.
#
# THE ORDINARY WAY TO SET THIS UP IS Settings > Notifications IN THE APP, not
# this file: the bot token, the chat id and the on/off switch all live in the
# account's settings, and the values here are a FALLBACK for a deployment that
# is never configured through the UI. The account's own values win when both
# are set.
#
# This flag is an operator KILL SWITCH rather than the feature's on/off. It
# defaults to true, and nothing is sent regardless until the account turns
# notifications on AND a token and chat id exist. Set it false to guarantee a
# deployment can never message anyone, whatever the settings blob says.
#
# BEFORE turning notifications on anywhere, read the egress note in
# deploy/smylte.service. The unit is loopback-only, so until it is widened every
# send fails at connect and nothing arrives — and "Send a test message" in
# Settings is the fastest way to find that out.
SMYLTE_NOTIFY_ENABLED=true
# From @BotFather. A SECRET: it is the whole bot. Set here it never lands in
# smylte.db and so never in a backup of it, which is the one advantage this file
# has over Settings; set in the app it is stored in the clear, like the booking
# link tokens beside it, because the app has to reproduce it to send.
# Rotating it is /revoke in BotFather plus re-entering it.
SMYLTE_TELEGRAM_BOT_TOKEN=REPLACE_bot_token
# The chat the bot sends to — your own user id for a DM, negative for a group.
# A bot cannot open a conversation, so message it once first or the first send
# fails with "chat not found".
SMYLTE_TELEGRAM_CHAT_ID=REPLACE_chat_id
# How often the scheduler wakes. This is the resolution of the whole feature:
# an event alert can be up to this late, which is why the lead time is floored
# well above it. Raise it on a small box — the event rule re-expands every
# recurring calendar resource on each pass.
SMYLTE_NOTIFY_INTERVAL=60

# --- Email → suggested tasks (OPTIONAL; off unless enabled) ---
# Reads mail through Proton Mail Bridge and proposes tasks for approval. THE
# ORDINARY WAY TO SET IT UP IS Settings > Email IN THE APP: the switch, the
# model, Bridge's host/port/username, the folders and the sender lists all live
# there and apply without a restart. See docs/DEPLOY.md, "Email → suggested
# tasks", for Bridge's certificate and the egress rule it needs.
#
# An operator KILL SWITCH, like SMYLTE_NOTIFY_ENABLED: true lets the account
# turn the feature on; false guarantees this deployment never reads mail or
# calls Anthropic, whatever the settings say.
SMYLTE_MAIL_ENABLED=true
# The secrets are write-only in the app and live in the OS keyring or an
# encrypted file (below) — never in smylte.db. Set here, they override what the
# app stored and never touch either store. Leave them unset to use Settings.
#SMYLTE_ANTHROPIC_API_KEY=REPLACE_anthropic_api_key
#SMYLTE_MAIL_IMAP_PASSWORD=REPLACE_bridge_generated_password
# Optional. With it, TypeSafe Jev decides task-or-event and the duplicate check
# (Claude decides when Jev is unsure); without it, Claude decides everything.
#SMYLTE_TYPESAFE_API_KEY=REPLACE_typesafe_api_key
# Where those secrets are kept: auto (the OS keyring if this process can reach
# one, else the encrypted file), keyring, or file. The choice is recorded the
# first time a secret is saved and kept from then on.
SMYLTE_SECRETS_BACKEND=auto
# The encrypted file and its key. The file defaults to secrets.enc next to
# SMYLTE_DB; the key to ~/.config/smylte/secrets.key, or to the systemd
# credential `smylte-secrets-key` when the unit loads one (LoadCredential=) —
# which is the way to do it under this unit, since /home is read-only to the
# service. The key is refused if other users can read it.
#SMYLTE_SECRETS_FILE=/var/lib/smylte/secrets.enc
# Only for running outside this unit. Under it, leave this unset and use
# LoadCredential: pointed at root's /etc/smylte/secrets.key, the service cannot
# read it.
#SMYLTE_SECRETS_KEY_FILE=/home/<user>/.config/smylte/secrets.key
