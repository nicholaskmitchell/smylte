<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0, NOT net8.0-windows. The app targets net8.0-windows with
         UseWindowsForms, and a ProjectReference to it would drag in the Windows
         Desktop runtime pack — which has no Linux build, so the tests could be
         compiled but never run off a Windows runner. Linking the sources under a
         portable TFM instead means this suite runs anywhere, including locally.

         The trade, stated deliberately: if either linked file ever takes a
         Windows-only dependency, this project stops compiling. That is the right
         failure — these two files are the client's portable logic (an HTTP path
         resolver, a cookie rewriter, a directory swap), and none of it should
         need WinForms. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Smylte.Desktop.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Settings' two DPAPI calls are Windows-only, and under a portable TFM the
         platform analyser says so. Nothing here calls them — the password never
         enters a test — and the app itself compiles under net8.0-windows where
         the check passes, so the warning is about this project's TFM rather than
         about the code. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Settings comes along because Updater takes one; its DPAPI calls are only
         reached by SetPassword/GetPassword, which nothing here touches. -->
    <Compile Include="../Smylte.Desktop/LocalServer.cs" />
    <Compile Include="../Smylte.Desktop/Updater.cs" />
    <Compile Include="../Smylte.Desktop/Settings.cs" />
    <!-- LocalServer serves the desktop bridge, so it needs the contract. A bare
         interface with no Windows dependency, which is why linking it here does
         not cost this project its portable TFM. -->
    <Compile Include="../Smylte.Desktop/IDesktopBridge.cs" />
    <!-- The portable halves of two files that are otherwise Windows: the colour
         arithmetic the host chrome decides from, the five icon names and the
         contrast rule behind Auto, and the password protector. All three are
         linked by the Linux client too, which is the point of splitting them —
         and none of them had a test before, because until now they only ever
         ran inside a WinForms process this suite cannot start. -->
    <Compile Include="../Smylte.Desktop/Theme.cs" />
    <Compile Include="../Smylte.Desktop/IconChoice.cs" />
    <Compile Include="../Smylte.Desktop/PasswordProtector.cs" />
    <!-- The floating window's resize ring: thirty lines of corner arithmetic,
         shared by both clients and untestable while it lived inside a WinForms
         message loop. Every one of its failure modes is silent. -->
    <Compile Include="../Smylte.Desktop/FloatRing.cs" />
    <!-- Setting an environment variable so that NATIVE code can read it, which
         `Environment.SetEnvironmentVariable` does not do on Linux. The whole
         X11 default rested on it, and the managed API reads its own write back
         so nothing looked wrong. -->
    <Compile Include="../Smylte.Desktop/NativeEnv.cs" />
    <!-- The Exec line of the desktop entry. The rest of DesktopEntry is GTK and
         the filesystem; this is the string function that was wrong. -->
    <Compile Include="../Smylte.Desktop.Linux/DesktopEntryText.cs" />
    <!-- Write-only-if-different. It gates a process spawn with a ten-second
         wait, so the branch that decides nothing happened is the branch worth
         pinning. -->
    <Compile Include="../Smylte.Desktop/FileSync.cs" />
    <!-- The icon comes in as bytes rather than as a linked source file, so
         AppIconTests asserts on the identical blob <ApplicationIcon> stamps into
         the exe. LogicalName pins the resource name: without it, the linked path
         would decide it. -->
    <EmbeddedResource Include="../Smylte.Desktop/app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="../Smylte.Desktop/icons/*.ico" LogicalName="%(Filename)%(Extension)" />
    <!-- The same four variants as the GTK client carries them: loose PNGs at
         the freedesktop sizes plus a scalable SVG. Prefixed, because
         `accent-256.png` and `app.ico` are the same art and only the container
         differs — a bare filename here would read as a second icon set. -->
    <EmbeddedResource Include="../Smylte.Desktop.Linux/icons/*.png" LogicalName="linux.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Smylte.Desktop.Linux/icons/*.svg" LogicalName="linux.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
