<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Smylte</AssemblyName>
    <RootNamespace>Smylte.Desktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- These are the strings Windows shows ABOUT the exe, and with neither set
         it had nothing to show: SmartScreen's warning named no publisher at all
         and Explorer's Details tab was blank. The exe is unsigned and this does
         not change that — the warning still appears — but an unsigned binary
         that says who wrote it and what it is reads differently from one that
         says nothing. -->
    <Company>Nicholas K. Mitchell</Company>
    <Product>Smylte</Product>

    <!-- The WinForms source generator's default is SystemAware, which this
         project was inheriting silently by not setting the property.
         System-aware means the process asks the primary monitor for its DPI once
         at startup; on any monitor at a different scale factor, Windows
         bitmap-stretches the whole window — frame, title bar, and title-bar icon
         — rather than letting it redraw. On a mixed-DPI desk that is a blurry
         window no icon work can fix, and it is a second, independent cause of
         "this doesn't look like a Windows app".

         Verified safe to set here specifically: SetHighDpiMode silently fails if
         an application manifest already declares dpiAware, and this project has
         no app.manifest and declares none. Program.Main also already calls
         ApplicationConfiguration.Initialize() before creating any window, which
         is the ordering SetProcessDpiAwarenessContext requires — it was moved
         ahead of the single-instance check for the MessageBox there, and that
         happens to be exactly what this needs too.

         Worth re-checking by hand when this changes: WebView2 can briefly
         disagree about scale while a window is dragged between monitors, and
         SetupForm is a FixedDialog with a hard-coded ClientSize(580, 400). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Self-contained single file: the target machine needs no .NET install.
         Not trimmed — WinForms reflects over its own types, and trimming it is a
         reliable way to produce an exe that starts and then dies on a dialog.

         That costs size: ~156 MB uncompressed, ~69 MB with the bundle compressed
         below. A framework-dependent build would be 1.4 MB, but only runs after
         someone installs the .NET Desktop Runtime, which Windows does not ship.
         Trading 69 MB for "download it and double-click" is the right way round
         here, because the exe is fetched once — every later update replaces the
         web assets, not this file. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon above stamps the *file* icon; this embeds the same file
         so `new Icon(typeof(MainForm), "app.ico")` can find it for the window.
         RootNamespace makes the resource name Smylte.Desktop.app.ico, which is
         what that constructor looks for. -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WebView2 *runtime* ships with Windows 10/11; this is only the
         managed wrapper.

         PINNED, where this used to float on `1.0.*`. Nothing here depends on a
         specific build, but the exe this links into is self-contained, unsigned,
         and published to the rolling `desktop-latest` release — and `1.0.*`
         meant nothing in the repo recorded which package was in any shipped
         binary. Two consequences, both real: ci.yml and desktop-release.yml
         resolve independently at different instants, so the artifact that was
         tested and the artifact that ships could contain different packages;
         and rolling back a bad release meant guessing which 1.0.x the last good
         exe held. NuGet restore also executes the resolved package's build
         targets on the runner, which is the supply-chain surface ci.yml's own
         header names. This value is what `1.0.*` resolved to when it was
         written, so pinning changed nothing about the build — bump it
         deliberately, in a commit a reviewer can see. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <!-- DPAPI. Not in the base framework on .NET 8 — it is its own package. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
