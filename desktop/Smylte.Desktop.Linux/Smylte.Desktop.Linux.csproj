<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- Plain net8.0, NOT net8.0-windows, and that is the whole shape of this
         project: it shares its logic with the Windows client by LINKING the
         sources below rather than by referencing that project, which would drag
         in a Windows Desktop runtime pack that has no Linux build. The same
         trade Smylte.Desktop.Tests already states applies here — if a linked
         file ever takes a Windows-only dependency, this project stops
         compiling, and that is the intended failure. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The same namespace as the Windows client, because the linked files are
         in it and this project's own types sit beside them. -->
    <RootNamespace>Smylte.Desktop</RootNamespace>
    <AssemblyName>Smylte-linux-x86_64</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Nicholas K. Mitchell</Company>
    <Product>Smylte</Product>

    <!-- Self-contained single file, for the same reason the exe is one: the
         target machine needs no .NET install, and "download it and run it" is
         the whole install story. ~75 MB, fetched once — every later update
         replaces the web assets, not this file.

         What it does NOT carry is GTK or WebKitGTK. Those are the system's,
         exactly as WebView2 is the system's on Windows, and GirCore reaches
         them by dlopen rather than by linking — so nothing here needs them
         present to BUILD, and CI can produce this artifact on a runner with no
         GTK installed at all. Program.cs checks for them at startup and says
         which package is missing, because the alternative is a process that
         dies before it can draw anything to say so. -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Not trimmed, and for a sharper reason than the Windows client's: every
         GirCore call goes through a marshalling layer that reflects over
         generated types, and a trimmer that removes one produces a binary that
         starts and then dies the first time a signal fires. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared client. These files live in desktop/Smylte.Desktop and STAY
         there: desktop-release.yml computes `git rev-parse
         HEAD:desktop/Smylte.Desktop` to decide whether the Windows exe needs
         republishing, and backend/tests/test_csp.py reads LocalServer.cs by
         that path to diff its Content-Security-Policy against csp.py's. Moving
         them into a shared project would break both, silently, and the second
         one would go unnoticed until a policy drifted. -->
    <Compile Include="../Smylte.Desktop/LocalServer.cs" />
    <Compile Include="../Smylte.Desktop/IDesktopBridge.cs" />
    <Compile Include="../Smylte.Desktop/Updater.cs" />
    <Compile Include="../Smylte.Desktop/Settings.cs" />
    <Compile Include="../Smylte.Desktop/Session.cs" />
    <Compile Include="../Smylte.Desktop/Theme.cs" />
    <Compile Include="../Smylte.Desktop/IconChoice.cs" />
    <Compile Include="../Smylte.Desktop/PasswordProtector.cs" />
    <Compile Include="../Smylte.Desktop/FloatRing.cs" />
    <Compile Include="../Smylte.Desktop/NativeEnv.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The four icon variants, at the freedesktop sizes, generated by
         backend/dev/build_app_icon.py from frontend/public/favicon.svg and
         committed. Embedded rather than installed because the window icon has
         to be switchable at runtime and GTK4 can only set one by NAME — so the
         client unpacks these into its own data folder and adds that to the icon
         search path.

         The files are named `<variant>-<size>.png` in one flat directory
         rather than nested by size, so LogicalName is the filename and nothing
         else. A nested tree would need the path to decide the resource name,
         and a directory rename would then silently break every lookup — which
         is the failure the Windows csproj already calls out for its .ico
         glob. -->
    <EmbeddedResource Include="icons/*.png" LogicalName="icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="icons/*.svg" LogicalName="icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- GirCore: C# bindings for GTK4, WebKitGTK 6.0 and libsoup 3, generated
         from the same GIR data GNOME publishes.

         PINNED EXACTLY, for the reason Smylte.Desktop.csproj gives for
         Microsoft.Web.WebView2 — the binary this links into is self-contained,
         unsigned and published to a rolling release, so "which package was in
         the artifact that shipped" has to be a thing the repository records.
         Sharper here than there: GirCore is pre-1.0 and says so, and its
         generated surface changes between minor versions. A float would mean a
         build that compiled last week and does not today, for a reason no
         commit shows.

         No libadwaita, deliberately. Adw.ApplicationWindow and Adw.StyleManager
         would each save a few lines — a headerless window and a light/dark
         read — but GTK4's own SetTitlebar gives the first and the XDG settings
         portal gives the second, and skipping it drops both a pinned binding
         and a runtime .so this client would otherwise have to find and check
         for. Two dependencies is a smaller surface to explain than three. -->
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.8.1" />
    <PackageReference Include="GirCore.Gdk-4.0" Version="0.8.1" />
    <PackageReference Include="GirCore.Gio-2.0" Version="0.8.1" />
    <PackageReference Include="GirCore.GLib-2.0" Version="0.8.1" />
    <PackageReference Include="GirCore.GObject-2.0" Version="0.8.1" />
    <PackageReference Include="GirCore.WebKit-6.0" Version="0.8.1" />
    <PackageReference Include="GirCore.Soup-3.0" Version="0.8.1" />

    <!-- DPAPI. Never CALLED here — PasswordProtector takes the derived-key arm
         off Windows — but the Windows arm is in the same linked file and has to
         compile, and `ProtectedData` is a package rather than part of the base
         framework on .NET 8. Same version the other two projects pin. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
