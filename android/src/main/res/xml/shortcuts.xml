<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon for "Server settings": what the desktop
     clients' setup flag does. Two intents, so Back from the settings screen
     lands in the app rather than on the home screen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="setup"
        android:shortcutLongLabel="@string/shortcut_setup_long"
        android:shortcutShortLabel="@string/shortcut_setup">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="com.nicholaskmitchell.smylte.MainActivity"
            android:targetPackage="com.nicholaskmitchell.smylte" />
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.nicholaskmitchell.smylte.SetupActivity"
            android:targetPackage="com.nicholaskmitchell.smylte" />
    </shortcut>
</shortcuts>
