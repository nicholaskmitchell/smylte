<?xml version="1.0" encoding="utf-8"?>
<!-- What a window shows while the app is locked (LockScreen). Nothing of the
     page or the settings: they are hidden behind it. It has no background of
     its own, so the window's colour shows, as it does behind "Starting…". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lock"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:accessibilityPaneTitle="@string/lock_title"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/lock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/lock_title"
        android:textSize="20sp" />

    <!-- Why the last prompt failed, in the system's words; read out when it changes. -->
    <TextView
        android:id="@+id/lock_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:textSize="14sp" />

    <Button
        android:id="@+id/lock_unlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/lock_unlock" />
</LinearLayout>
