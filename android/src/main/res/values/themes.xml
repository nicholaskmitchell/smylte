<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight, so the WebView's prefers-color-scheme follows the system, and
         transparent bars because the window draws edge to edge and paints the
         space behind them in the page's own background (MainActivity). -->
    <style name="Theme.Smylte" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
