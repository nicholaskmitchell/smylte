<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- For the client update only: handing a downloaded, verified APK to the
         system installer. Android still asks the user to allow it once, and
         still refuses any APK not signed with this app's own key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- No backup, cloud or device-to-device. The password and token are sealed
         with a keystore key that does not travel, so a restored copy could not
         read them anyway, and the WebView's session cookie should not move to
         another device by itself. Every setting is one setup screen away. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Smylte"
        android:usesCleartextTraffic="false">

        <!-- The WebView only ever shows the user's own server; every other
             origin opens in the browser. Safe Browsing would send lookups about
             that server to Google for no protection, and the usage metrics are
             not ours to opt anyone into. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- configChanges: a rotation, a fold, a keyboard or a dark-mode switch
             would otherwise destroy the activity and reload the page, losing
             whatever was open in it. The window handles each of these itself. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Reached from MainActivity and from the launcher shortcut, which is
             an explicit intent from the launcher, so it needs no filter and is
             not exported. -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Serves the one downloaded APK to the system installer, for exactly
             as long as the grant on the install intent lasts. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
