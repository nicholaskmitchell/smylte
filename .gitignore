# ── Secrets / tokens — NEVER commit ──────────────────────────────────────────
# Real config lives in /etc/smylte/ (outside the repo). Only *.env.example ships.
*.env
!*.env.example
/deploy/smylte-cloudflared.env

# ── User content & derived cache (holds REAL synced calendar/task data) ──────
/backend/smylte.db
/backend/smylte.db-shm
/backend/smylte.db-wal
/backend/*.db
/backend/*.sqlite3
# `*.db` does not match a `-wal`/`-shm` SUFFIX, so the sidecars need their own
# globs. Without them a working copy created before the Smylte rename — where
# the file is still tasks.db — has its WAL and shared-memory files untracked and
# stageable, and those hold real synced calendar and task content.
/backend/*.db-wal
/backend/*.db-shm

# ── Scratch Radicale runtime storage (test data) ─────────────────────────────
/scratch/data/

# ── Python ───────────────────────────────────────────────────────────────────
/backend/.venv/
__pycache__/
*.py[cod]
/backend/.pytest_cache/

# ── Node / frontend build artifacts (rebuilt by autopull) ────────────────────
/frontend/node_modules/
# Unanchored too. Running npx from the repo ROOT creates a second node_modules
# here, which `/frontend/node_modules/` does not match — a vitest cache file from
# it was committed before this line existed.
node_modules/
# And once more WITHOUT the trailing slash. A pattern ending in `/` matches only
# a directory, and git does not consider a symlink one — so a node_modules
# symlinked in (what you do to share one install between checkouts) showed up as
# untracked and could be committed.
node_modules
/frontend/dist/
# Failure screenshots from the browser test project. vitest writes one beside the
# failing spec, so this lands INSIDE src/ rather than in a build directory —
# unanchored for the same reason node_modules is above.
__screenshots__/

# ── .NET / Windows client build artifacts (built by CI, never committed) ─────
/desktop/**/bin/
/desktop/**/obj/
/desktop/**/publish/

# ── Logs & OS cruft ──────────────────────────────────────────────────────────
*.log
.DS_Store
